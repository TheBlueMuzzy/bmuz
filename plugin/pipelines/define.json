{
  "id": "define",
  "version": 1,
  "description": "Define: The Concept (F232, the approved script's Stage 2, framework .planning/research/bmuz-vision/bmuz-design-doc.html): 2.0 Welcome to Define · 2.1 The Feelings · 2.2 The 3 Pillars · 2.3 The Pitch (research offered first; 'show me your take') · 2.4 The Core Loop · 2.5 Platform & Play · 2.6 Clash Check · 2.7 Scope, First Pass · 2.8 Concept Lock (gate). Turns the loose idea into decisions, from the biggest down, writing GDD Part 1 chapter by chapter as chosen; it ends with a one-page concept and a first, rough scope and risk report. Choosing is the creative's: an auto run never locks. Every fixed line comes from plugin/script.md, word for word.",
  "watchdogMs": 1200000,
  "next": { "pipeline": "design", "ask": false },
  "steps": [
    {
      "id": "path",
      "kind": "script",
      "needs": [],
      "description": "Which path: a finished, played game (Ideate found its rules) or a new idea (F233); worked out, never asked",
      "run": ["node", "{plugin}/scripts/define.mjs", "path"],
      "results": ["convert", "fresh"]
    },
    {
      "id": "welcome",
      "kind": "talk",
      "needs": ["path"],
      "no": "2.0",
      "title": "Welcome to Define",
      "description": "What Define is for and how it flows",
      "tools": ["Read"],
      "lines": ["define.welcome"],
      "opening": ["define.welcome"],
      "craft": "craft/define-welcome.md",
      "when": "{fresh}"
    },
    {
      "id": "welcome-rules",
      "kind": "talk",
      "needs": ["welcome"],
      "when": "{convert}",
      "no": "2.0",
      "title": "Welcome to Define",
      "description": "A finished game (F233): what Define is for when the rules already decide most of it",
      "tools": ["Read"],
      "lines": ["define.welcome.rules"],
      "opening": ["define.welcome.rules"],
      "craft": "craft/define-welcome-rules.md"
    },
    {
      "id": "decides",
      "kind": "talk",
      "needs": ["welcome-rules"],
      "when": "{convert}",
      "no": "2.1",
      "title": "What Your Rulebook Decides",
      "description": "A finished game (F233): the feelings, the 3 pillars, the pitch and the core loop, drafted from the rules; confirm or correct in one pass",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.rules", "define.rules.ok"],
      "must": ["define.rules", "define.rules.ok"],
      "opening": ["define.rules"],
      "craft": "craft/define-rules.md",
      "results": ["chapters", "feelings", "feeling", "pillars", "oneliner", "loop"],
      "collects": [
        { "field": "feel.target", "what": "The feelings", "chapter": 1, "line": "define.rules.ok", "neededBy": ["design"] },
        { "field": "feel.know", "what": "How we'll know a player feels it", "chapter": 1, "line": "define.rules.ok", "neededBy": ["design"] },
        { "field": "pillars", "what": "The 3 pillars", "chapter": 2, "line": "define.rules.ok", "neededBy": ["design"] },
        { "field": "pitch.oneliner", "what": "The one-liner", "chapter": 3, "line": "define.rules.ok", "neededBy": ["design", "store"] },
        { "field": "pitch.lines", "what": "The pitch, in a few lines", "chapter": 3, "line": "define.rules.ok", "neededBy": ["store"] },
        { "field": "loop", "what": "The core loop", "chapter": 4, "line": "define.rules.ok", "neededBy": ["design", "build"] }
      ]
    },
    {
      "id": "decides-gdd",
      "kind": "script",
      "needs": ["decides"],
      "when": "{convert}",
      "description": "What your rulebook decides, chosen, into the GDD (chapters 1–4)",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "decides", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "feelings",
      "kind": "talk",
      "needs": ["decides-gdd"],
      "no": "2.1",
      "title": "The Feelings",
      "description": "The one or two feelings that are this game, how we'd know, and what it won't have",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.feelings", "define.feelings.moments", "define.feelings.own", "define.feelings.match", "define.feelings.right", "define.feelings.eight", "define.feelings.know", "define.feelings.not", "any.keep"],
      "must": ["define.feelings.know", "define.feelings.not"],
      "opening": ["define.feelings"],
      "craft": "craft/define-feelings.md",
      "results": ["chapters", "feelings", "feeling"],
      "collects": [
        { "field": "feel.target", "what": "The feelings", "chapter": 1, "line": "define.feelings.right", "neededBy": ["design"] },
        { "field": "feel.know", "what": "How we'll know a player feels it", "chapter": 1, "line": "define.feelings.know", "neededBy": ["design"] },
        { "field": "feel.not", "what": "What it deliberately won't have", "chapter": 1, "line": "define.feelings.not", "neededBy": [] }
      ],
      "when": "{fresh}"
    },
    {
      "id": "feelings-gdd",
      "kind": "script",
      "needs": ["feelings"],
      "when": "{fresh}",
      "description": "The Feelings, chosen, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "feelings", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "pillars",
      "kind": "talk",
      "needs": ["feelings-gdd"],
      "no": "2.2",
      "title": "The 3 Pillars",
      "description": "Three short rules that settle arguments later",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.pillars", "define.pillars.take", "define.pillars.own", "define.pillars.test", "define.pillars.slogan", "any.keep"],
      "must": ["define.pillars.take", "define.pillars.test"],
      "opening": ["define.pillars"],
      "craft": "craft/define-pillars.md",
      "results": ["chapters", "pillars"],
      "collects": [
        { "field": "pillars", "what": "The 3 pillars", "chapter": 2, "line": "define.pillars.take", "neededBy": ["design"] }
      ],
      "when": "{fresh}"
    },
    {
      "id": "pillars-gdd",
      "kind": "script",
      "needs": ["pillars"],
      "when": "{fresh}",
      "description": "The 3 Pillars, chosen, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "pillars", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "pitch-ask",
      "kind": "talk",
      "needs": ["pillars-gdd"],
      "no": "2.3",
      "title": "The Pitch",
      "description": "The game in a few lines; research the closest games first?",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.pitch", "define.pitch.research"],
      "opening": ["define.pitch"],
      "craft": "craft/define-pitch-ask.md",
      "results": ["research", "brief"],
      "when": "{fresh}"
    },
    {
      "id": "prior-art",
      "kind": "flow",
      "needs": ["pitch-ask"],
      "when": "{research}",
      "no": "2.3",
      "title": "The Pitch",
      "description": "The closest games: what players love and miss in them, and what's new here (only when you asked)",
      "workflow": "bmuz:research-flow",
      "args": {
        "checker": "{plugin}/scripts/check-sources.mjs",
        "topic": "prior-art",
        "brief": "{brief}",
        "youAre": "",
        "collected": { "feelings": "{feelings}", "pillars": "{pillars}" },
        "out": ".planning/research/define-prior-art.md"
      },
      "agentTools": ["ToolSearch", "WebSearch", "WebFetch", "StructuredOutput", "Write"],
      "writes": [".planning/research/define-prior-art.md"],
      "timeoutMs": 1800000,
      "done": { "type": "script-ok", "run": ["node", "{plugin}/scripts/check-sources.mjs", ".planning/research/define-prior-art.md"] }
    },
    {
      "id": "pitch",
      "kind": "talk",
      "needs": ["prior-art"],
      "no": "2.3",
      "title": "The Pitch",
      "description": "Your take or mine: 3–5 lines written to \"you\", and one line",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.pitch.found", "define.pitch.take", "define.pitch.write", "define.pitch.mine", "define.pitch.how", "define.pitch.different", "define.pitch.meets", "define.pitch.breath", "any.keep"],
      "must": ["define.pitch.take", "define.pitch.breath"],
      "craft": "craft/define-pitch.md",
      "results": ["chapters", "oneliner"],
      "collects": [
        { "field": "pitch.oneliner", "what": "The one-liner", "chapter": 3, "line": "define.pitch.breath", "neededBy": ["design", "store"] },
        { "field": "pitch.lines", "what": "The pitch, in a few lines", "chapter": 3, "line": "define.pitch.take", "neededBy": ["store"] }
      ],
      "recap": ["research"],
      "when": "{fresh}"
    },
    {
      "id": "pitch-gdd",
      "kind": "script",
      "needs": ["pitch"],
      "when": "{fresh}",
      "description": "The Pitch, chosen, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "pitch", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "loop",
      "kind": "talk",
      "needs": ["pitch-gdd"],
      "no": "2.4",
      "title": "The Core Loop",
      "description": "What you do, over and over: the heartbeat of the game",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.loop", "define.loop.steps", "define.loop.time", "define.loop.verbs", "define.loop.here", "define.loop.ok", "any.keep"],
      "must": ["define.loop.here", "define.loop.ok"],
      "opening": ["define.loop"],
      "craft": "craft/define-loop.md",
      "results": ["chapters", "loop"],
      "collects": [
        { "field": "loop", "what": "The core loop", "chapter": 4, "line": "define.loop.ok", "neededBy": ["design", "build"] }
      ],
      "when": "{fresh}"
    },
    {
      "id": "loop-gdd",
      "kind": "script",
      "needs": ["loop"],
      "when": "{fresh}",
      "description": "The Core Loop, chosen, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "loop", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "platform",
      "kind": "talk",
      "needs": ["loop-gdd"],
      "no": "2.5",
      "title": "Platform & Play",
      "description": "Where it's played first, and who with",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.platform.now", "define.platform.where", "define.platform.first", "define.platform.who", "define.platform.ai", "any.keep"],
      "must": ["define.platform.where", "define.platform.first", "define.platform.who"],
      "opening": ["define.platform.now"],
      "craft": "craft/define-platform.md",
      "results": ["chapters", "platform"],
      "collects": [
        { "field": "platform.where", "what": "Where it's played, and what the player holds", "chapter": 5, "line": "define.platform.where", "neededBy": ["design", "build"] },
        { "field": "platform.first", "what": "The first platform", "chapter": 5, "line": "define.platform.first", "neededBy": ["build", "store"] },
        { "field": "players.who", "what": "Who else plays", "chapter": 5, "line": "define.platform.who", "neededBy": ["design", "build"] },
        { "field": "computer.ai", "what": "Whether the computer must play it", "chapter": 5, "line": "define.platform.ai", "neededBy": ["design"] }
      ],
      "when": "{fresh}"
    },
    {
      "id": "platform-gdd",
      "kind": "script",
      "needs": ["platform"],
      "when": "{fresh}",
      "description": "Platform & Play, chosen, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "platform", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "platform-rules",
      "kind": "talk",
      "needs": ["platform-gdd"],
      "when": "{convert}",
      "no": "2.5",
      "title": "Platform & Play",
      "description": "A finished game (F233): where it's played first, and who with; what your rules or your own words already say shows first, one tap to keep (F235: asked here once, never in Ideate too)",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.platform.now", "define.platform.where", "define.platform.first", "define.platform.who", "define.platform.ai", "any.keep"],
      "must": ["define.platform.first"],
      "opening": ["define.platform.now"],
      "craft": "craft/define-platform-rules.md",
      "results": ["chapters", "platform"],
      "collects": [
        { "field": "platform.where", "what": "Where it's played, and what the player holds", "chapter": 5, "line": "define.platform.where", "neededBy": ["design", "build"] },
        { "field": "platform.first", "what": "The first platform", "chapter": 5, "line": "define.platform.first", "neededBy": ["build", "store"] },
        { "field": "players.who", "what": "Who else plays", "chapter": 5, "line": "define.platform.who", "neededBy": ["design", "build"] },
        { "field": "computer.ai", "what": "Whether the computer must play it", "chapter": 5, "line": "define.platform.ai", "neededBy": ["design"] }
      ]
    },
    {
      "id": "platform-rules-gdd",
      "kind": "script",
      "needs": ["platform-rules"],
      "when": "{convert}",
      "description": "Platform & Play, chosen, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "platform-rules", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "clash",
      "kind": "talk",
      "needs": ["platform-rules-gdd"],
      "no": "2.6",
      "title": "Clash Check",
      "description": "What the clash check does, before the reviewers read",
      "tools": ["Read"],
      "lines": ["define.clash"],
      "opening": ["define.clash"],
      "craft": "craft/define-clash.md",
      "when": "{fresh}"
    },
    {
      "id": "clash-review",
      "kind": "flow",
      "needs": ["clash"],
      "no": "2.6",
      "title": "Clash Check",
      "description": "Separate reviewers read Part 1 for things that pull against each other (they choose nothing)",
      "workflow": "bmuz:clash-flow",
      "args": { "gdd": ".planning/GDD.md", "decisions": ".bmuz/decisions.md", "out": ".planning/research/define-clash.md" },
      "agentTools": ["Read", "Glob", "Grep", "StructuredOutput", "Write"],
      "writes": [".planning/research/define-clash.md"],
      "timeoutMs": 1200000,
      "done": { "type": "file-contains", "path": ".planning/research/define-clash.md", "text": "## Clashes" },
      "when": "{fresh}"
    },
    {
      "id": "clashes",
      "kind": "talk",
      "needs": ["clash-review"],
      "no": "2.6",
      "title": "Clash Check",
      "description": "Each clash and what you'd do: keep both, change one, or park one",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.clash.one", "define.clash.what", "define.clash.none"],
      "craft": "craft/define-clashes.md",
      "results": ["clashes"],
      "when": "{fresh}"
    },
    {
      "id": "clashes-gdd",
      "kind": "script",
      "needs": ["clashes"],
      "when": "{fresh}",
      "description": "What you decided about each clash, into the GDD (risks, changes, ideas for later)",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "clashes", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "scope",
      "kind": "talk",
      "needs": ["clashes-gdd"],
      "no": "2.7",
      "title": "Scope, First Pass",
      "description": "Must / Should / Could / Won't, effort vs impact",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.scope", "define.scope.smallest", "define.scope.idea", "define.scope.wont", "define.scope.someday", "any.keep"],
      "must": ["define.scope.smallest", "define.scope.someday"],
      "opening": ["define.scope"],
      "craft": "craft/define-scope.md",
      "results": ["chapters", "musts"],
      "collects": [
        { "field": "scope.smallest", "what": "The smallest version that still gives the feeling", "chapter": 6, "line": "define.scope.smallest", "neededBy": ["design"] },
        { "field": "scope.musts", "what": "Must, should, could or won't, for each idea", "chapter": 6, "line": "define.scope.idea", "neededBy": ["design", "build"] },
        { "field": "platform.someday", "what": "The someday platforms (asked once the features are sorted)", "chapter": 6, "line": "define.scope.someday", "neededBy": ["store"] }
      ]
    },
    {
      "id": "scope-gdd",
      "kind": "script",
      "needs": ["scope"],
      "description": "The scope and the effort vs impact chart, into the GDD and onto your project page",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "scope", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "slice",
      "kind": "talk",
      "needs": ["scope-gdd"],
      "no": "2.7",
      "title": "Scope, First Pass",
      "description": "The chart, the vertical slice, and my first report",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["define.scope.chart", "define.scope.slice", "define.scope.slice.ok", "define.scope.report"],
      "must": ["define.scope.slice", "define.scope.slice.ok", "define.scope.report"],
      "opening": ["define.scope.chart"],
      "craft": "craft/define-slice.md",
      "results": ["chapters", "slice", "later"],
      "collects": [
        { "field": "scope.slice", "what": "The vertical slice", "chapter": 6, "line": "define.scope.slice.ok", "neededBy": ["design", "build"] }
      ]
    },
    {
      "id": "slice-gdd",
      "kind": "script",
      "needs": ["slice"],
      "description": "The slice, the risks and the new sketch ideas, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "slice", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "change",
      "kind": "talk",
      "needs": ["slice-gdd"],
      "onBack": true,
      "no": "2.8",
      "title": "Concept Lock",
      "description": "What you want changed before you lock it (only when you said \"Not yet\")",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["any.keep"],
      "craft": "craft/define-change.md",
      "results": ["chapters"]
    },
    {
      "id": "change-gdd",
      "kind": "script",
      "needs": ["change"],
      "description": "Your changes, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "change", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "lock-show",
      "kind": "script",
      "needs": ["change-gdd"],
      "no": "2.8",
      "title": "Concept Lock",
      "description": "The concept, one page, on your project page",
      "run": ["node", "{plugin}/scripts/define.mjs", "lock-show"],
      "writes": [".planning/research/define-lock.md", ".planning/project-page.html"],
      "show": ".planning/research/define-lock.md",
      "stageEnd": true,
      "done": { "type": "file-contains", "path": ".planning/research/define-lock.md", "text": "**Concept Lock**" }
    },
    {
      "id": "lock",
      "kind": "gate",
      "needs": ["lock-show"],
      "no": "2.8",
      "title": "Concept Lock",
      "description": "Lock the concept?",
      "line": "define.lock.box",
      "approve": "Lock it: on to Design",
      "backTo": "change"
    },
    {
      "id": "locked",
      "kind": "script",
      "needs": ["lock"],
      "retries": 0,
      "description": "The concept locked: logged in the GDD's Decisions and Changes",
      "run": ["node", "{plugin}/scripts/define.mjs", "locked"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    }
  ]
}
