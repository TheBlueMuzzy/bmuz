{
  "_help": "Settings for unattended BMUZ runs (overnight, background): claude --settings <plugin>/settings/auto-run.json. Nothing may wait for an answer. Every workflow a pipeline launches is pre-approved here (npm run check:pipelines checks the list).",
  "env": {
    "BMUZ_AUTO": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Workflow(bmuz:hello-flow)",
      "Workflow(bmuz:research-flow)",
      "Workflow(bmuz:clash-flow)",
      "Workflow(bmuz:sketch-flow)",
      "Workflow(bmuz:build-flow)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "ToolSearch",
      "StructuredOutput",
      "mcp__bmuz__step_done",
      "mcp__bmuz__say",
      "mcp__bmuz__bug",
      "mcp__bmuz__idea",
      "mcp__bmuz__run"
    ]
  },
  "askUserQuestionTimeout": "60s",
  "skipWorkflowUsageWarning": true
}
