{
  "id": "discover",
  "version": 1,
  "description": "Discover a game idea (framework .planning/research/bmuz-vision/discover-creative-research.md section 6): experience first — spark, experience and fantasy, theme dig, simulation breakdown, mechanism shelf, prior art and twists — collecting the material for the game's building blocks into .planning/DISCOVER.md, then the material board. Collects, never chooses: Define makes the blocks. Wrap up after any step. (F228, 2026-11-10: no longer a stage — Ideate gathers the material now; kept on disk because its research flow becomes F229 — Research, callable anywhere.)",
  "watchdogMs": 1200000,
  "next": {"pipeline": "define"},
  "steps": [
    {
      "id": "spark",
      "kind": "talk",
      "needs": [],
      "description": "Spark: the idea in your words, who the player is, what excites you, hopes and fears",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob"],
      "craft": "craft/discover-spark.md",
      "results": ["brief", "slug", "youAre", "spark", "hopes", "fears", "onIce", "constraints"],
      "wrapTo": "bricks"
    },
    {
      "id": "experience",
      "kind": "talk",
      "needs": ["spark"],
      "description": "Experience and fantasy: the moments you hope a player has, and the dream it fulfils",
      "tools": ["AskUserQuestion", "ToolSearch", "Read"],
      "craft": "craft/discover-experience.md",
      "results": ["experiences", "stories", "aesthetics", "fantasies", "curiosity", "toy", "players"],
      "recap": ["brief", "youAre", "spark", "hopes"],
      "wrapTo": "bricks"
    },
    {
      "id": "theme",
      "kind": "talk",
      "needs": ["experience"],
      "description": "Theme: what you see, hear and know of this world, its tone, and what to research",
      "tools": ["AskUserQuestion", "ToolSearch", "Read"],
      "craft": "craft/discover-theme.md",
      "results": ["senses", "known", "life", "outside", "tone", "questions"],
      "recap": ["brief", "youAre", "spark", "experiences", "fantasies"],
      "wrapTo": "bricks"
    },
    {
      "id": "theme-dig",
      "kind": "flow",
      "needs": ["theme"],
      "always": true,
      "description": "Theme dig: research the subject itself, in and outside games (always runs: Discover always researches)",
      "workflow": "bmuz:research-flow",
      "args": {
        "topic": "theme",
        "brief": "{brief}",
        "youAre": "{youAre}",
        "collected": {
          "spark": "{spark}",
          "experiences": "{experiences}",
          "fantasies": "{fantasies}",
          "aesthetics": "{aesthetics}",
          "senses": "{senses}",
          "known": "{known}",
          "life": "{life}",
          "outside": "{outside}",
          "tone": "{tone}"
        },
        "fears": "{fears}",
        "onIce": "{onIce}",
        "constraints": "{constraints}",
        "questions": "{questions}",
        "out": ".planning/research/discover-{slug}-theme.md"
      },
      "agentTools": ["ToolSearch", "WebSearch", "WebFetch", "StructuredOutput", "Write"],
      "writes": [".planning/research/discover-{slug}-theme.md"],
      "timeoutMs": 1800000,
      "done": { "type": "script-ok", "run": ["node", "{plugin}/scripts/check-sources.mjs", ".planning/research/discover-{slug}-theme.md"] }
    },
    {
      "id": "simulation",
      "kind": "talk",
      "needs": ["theme-dig"],
      "description": "Simulation breakdown: the things in this world and their states, the verbs, the verb × noun grid, the choices",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob"],
      "craft": "craft/discover-simulation.md",
      "results": ["nouns", "verbs", "skills", "grid", "choices", "problems", "reminds"],
      "recap": ["brief", "slug", "youAre", "experiences", "fantasies", "tone"],
      "wrapTo": "bricks"
    },
    {
      "id": "mechanisms",
      "kind": "flow",
      "needs": ["simulation"],
      "description": "Mechanisms: research candidate mechanisms for each outcome verb, from designer-written sources",
      "workflow": "bmuz:research-flow",
      "args": {
        "topic": "mechanisms",
        "brief": "{brief}",
        "youAre": "{youAre}",
        "collected": {
          "verbs": "{verbs}",
          "skills": "{skills}",
          "nouns": "{nouns}",
          "choices": "{choices}",
          "experiences": "{experiences}",
          "fantasies": "{fantasies}",
          "aesthetics": "{aesthetics}"
        },
        "fears": "{fears}",
        "onIce": "{onIce}",
        "constraints": "{constraints}",
        "out": ".planning/research/discover-{slug}-mechanisms.md"
      },
      "agentTools": ["ToolSearch", "WebSearch", "WebFetch", "StructuredOutput", "Write"],
      "writes": [".planning/research/discover-{slug}-mechanisms.md"],
      "timeoutMs": 1800000,
      "done": { "type": "script-ok", "run": ["node", "{plugin}/scripts/check-sources.mjs", ".planning/research/discover-{slug}-mechanisms.md"] }
    },
    {
      "id": "mechanism-shelf",
      "kind": "talk",
      "needs": ["mechanisms"],
      "description": "Mechanism shelf: which mechanisms feel like your verbs, and which feel pasted on",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob"],
      "craft": "craft/discover-mechanism-shelf.md",
      "results": ["feelsRight", "pastedOn", "genres"],
      "recap": ["brief", "slug", "verbs"],
      "wrapTo": "bricks"
    },
    {
      "id": "prior-art",
      "kind": "flow",
      "needs": ["mechanism-shelf"],
      "description": "Prior art: research the games closest to this idea, what players praise and miss, hooks, anchors and twists",
      "workflow": "bmuz:research-flow",
      "args": {
        "topic": "prior-art",
        "brief": "{brief}",
        "youAre": "{youAre}",
        "collected": {
          "reminds": "{reminds}",
          "verbs": "{verbs}",
          "nouns": "{nouns}",
          "experiences": "{experiences}",
          "fantasies": "{fantasies}",
          "tone": "{tone}",
          "genres": "{genres}",
          "feelsRight": "{feelsRight}"
        },
        "fears": "{fears}",
        "onIce": "{onIce}",
        "constraints": "{constraints}",
        "out": ".planning/research/discover-{slug}-prior-art.md"
      },
      "agentTools": ["ToolSearch", "WebSearch", "WebFetch", "StructuredOutput", "Write"],
      "writes": [".planning/research/discover-{slug}-prior-art.md"],
      "timeoutMs": 1800000,
      "done": { "type": "script-ok", "run": ["node", "{plugin}/scripts/check-sources.mjs", ".planning/research/discover-{slug}-prior-art.md"] }
    },
    {
      "id": "twists",
      "kind": "talk",
      "needs": ["prior-art"],
      "description": "Prior art and twists: what the closest games missed, the familiar part and the new part, twists to try",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob"],
      "craft": "craft/discover-twists.md",
      "results": ["missed", "anchors", "hooks", "twists", "extremes"],
      "recap": ["brief", "slug", "youAre", "reminds"]
    },
    {
      "id": "save",
      "kind": "script",
      "needs": ["twists"],
      "always": true,
      "description": "Save: all the material of this run into .planning/DISCOVER.md (shelves only grow) and the run's section",
      "run": ["node", "{plugin}/scripts/discover-doc.mjs", ".planning/DISCOVER.md"],
      "writes": [".planning/DISCOVER.md"],
      "done": { "type": "file-contains", "path": ".planning/DISCOVER.md", "text": "## Shelves" }
    },
    {
      "id": "bricks",
      "kind": "talk",
      "needs": ["save"],
      "description": "the material board: what this run collected, and every open question",
      "tools": ["Read", "Glob", "Grep"],
      "craft": "craft/discover-bricks.md",
      "handoff": true,
      "results": ["found"],
      "recap": ["brief", "slug"]
    }
  ]
}
