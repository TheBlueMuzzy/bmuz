{
  "id": "design",
  "version": 1,
  "description": "Design: The Blueprint (F227, the approved script's Stage 3, framework .planning/research/bmuz-vision/bmuz-design-doc.html): 3.0 Welcome to Design · 3.1 Sketches, Round 1 · 3.2 The Rulebook · 3.3 Content & Balance · 3.4 Change Over Time · 3.5 Scope & Risks, Second Pass · 3.6 Players & Opponents (starts the TDD) · 3.7 Look & Sound · 3.8 Screens & Menus · 3.9 The Build Plan (told, not asked) · 3.10 Blueprint Review (gate). Works the game out in detail, the game itself then the digital game around it, writing GDD Parts 2 and 3, the rulebook, the content tables, the TDD and the roadmap. Choosing is the creative's: an auto run never approves. Every fixed line comes from plugin/script.md, word for word.",
  "watchdogMs": 1200000,
  "next": { "pipeline": "develop", "ask": false },
  "steps": [
    {
      "id": "welcome",
      "kind": "talk",
      "needs": [],
      "no": "3.0",
      "title": "Welcome to Design",
      "description": "What Design is for, in two halves",
      "tools": ["Read"],
      "lines": ["design.welcome"],
      "opening": ["design.welcome"],
      "craft": "craft/design-welcome.md"
    },
    {
      "id": "sketches",
      "kind": "talk",
      "needs": ["welcome"],
      "no": "3.1",
      "title": "Sketches, Round 1",
      "description": "Your sketch list, and how we'll know each answer, before anything is built",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.sketches", "design.sketches.list", "design.sketches.none", "design.sketches.order"],
      "opening": ["design.sketches"],
      "mustIf": { "design.sketches.order": "{build}" },
      "craft": "craft/design-sketches.md",
      "results": ["plan", "build"]
    },
    {
      "id": "sketch-prep",
      "kind": "script",
      "needs": ["sketches"],
      "when": "{build}",
      "description": "Each sketch's page from the /sketch starter (a numbers question gets a simulation file)",
      "run": ["node", "{plugin}/scripts/design.mjs", "sketch-prep"],
      "writes": [".planning/research/sketches/sketches.json", ".planning/project-page.html"]
    },
    {
      "id": "sketch-build",
      "kind": "flow",
      "needs": ["sketch-prep"],
      "when": "{build}",
      "no": "3.1",
      "title": "Sketches, Round 1",
      "description": "One fresh helper per sketch builds it (they decide nothing)",
      "workflow": "bmuz:sketch-flow",
      "args": { "plan": "{plan}", "dir": ".planning/research/sketches" },
      "agentTools": ["Read", "Write", "Edit", "Glob", "StructuredOutput"],
      "timeoutMs": 1800000,
      "done": { "type": "script-ok", "run": ["node", "{plugin}/scripts/design.mjs", "sketches-check"] }
    },
    {
      "id": "sims",
      "kind": "script",
      "needs": ["sketch-build"],
      "when": "{build}",
      "description": "The numbers questions' simulations, run",
      "run": ["node", "{plugin}/scripts/design.mjs", "sims"],
      "writes": [".planning/research/sketches/sketches.json"]
    },
    {
      "id": "sketch-play",
      "kind": "talk",
      "needs": ["sims"],
      "when": "{build}",
      "no": "3.1",
      "title": "Sketches, Round 1",
      "description": "Each sketch, played: did it answer the question?",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.sketch.ready", "design.sketch.answered", "design.sketch.sim"],
      "craft": "craft/design-sketch-play.md",
      "results": ["answers"]
    },
    {
      "id": "sketch-play-gdd",
      "kind": "script",
      "needs": ["sketch-play"],
      "description": "What the sketches showed, into the GDD (Decisions, Open Questions)",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "sketch-play", "loose"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "rules-ask",
      "kind": "talk",
      "needs": ["sketch-play-gdd"],
      "no": "3.2",
      "title": "The Rulebook",
      "description": "The rulebook's shape; read the closest games' rulebooks first?",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.rulebook", "design.rulebook.research"],
      "opening": ["design.rulebook"],
      "craft": "craft/design-rules-ask.md",
      "results": ["research", "brief"]
    },
    {
      "id": "rules-research",
      "kind": "flow",
      "needs": ["rules-ask"],
      "when": "{research}",
      "no": "3.2",
      "title": "The Rulebook",
      "description": "The closest games' rulebooks: how they explain similar rules (only when you asked)",
      "workflow": "bmuz:research-flow",
      "args": { "checker": "{plugin}/scripts/check-sources.mjs",
        "topic": "prior-art",
        "brief": "{brief}",
        "youAre": "",
        "questions": [
          "How do the rulebooks of the closest games explain one turn, step by step?",
          "How do they explain each action, the edge cases and what is secret?",
          "Which parts of those rulebooks do players say are confusing, and how were they fixed?"
        ],
        "out": ".planning/research/design-rulebooks.md"
      },
      "agentTools": ["ToolSearch", "WebSearch", "WebFetch", "StructuredOutput", "Write"],
      "writes": [".planning/research/design-rulebooks.md"],
      "timeoutMs": 1800000,
      "done": { "type": "script-ok", "run": ["node", "{plugin}/scripts/check-sources.mjs", ".planning/research/design-rulebooks.md"] }
    },
    {
      "id": "flow",
      "kind": "talk",
      "needs": ["rules-research"],
      "no": "3.2",
      "title": "The Rulebook",
      "description": "The heart first: one turn, step by step",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.rulebook.flow"],
      "opening": ["design.rulebook.flow"],
      "craft": "craft/design-flow.md",
      "results": ["rulebook"],
      "recap": ["research"]
    },
    {
      "id": "flow-rb",
      "kind": "script",
      "needs": ["flow"],
      "description": "The Flow, into the rulebook (its own tab on your project page)",
      "run": ["node", "{plugin}/scripts/rulebook.mjs", "step", "flow", "loose"],
      "writes": [".planning/design/RULEBOOK.md", ".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "flow-check",
      "kind": "talk",
      "needs": ["flow-rb"],
      "no": "3.2",
      "title": "The Rulebook",
      "description": "The Flow as written: is that how a turn goes?",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.rulebook.flow.here", "design.rulebook.flow.ok"],
      "must": ["design.rulebook.flow.ok"],
      "opening": ["design.rulebook.flow.here"],
      "craft": "craft/design-flow-check.md",
      "results": ["chapters"]
    },
    {
      "id": "flow-check-rb",
      "kind": "script",
      "needs": ["flow-check"],
      "description": "Any change to the Flow, into the rulebook",
      "run": ["node", "{plugin}/scripts/rulebook.mjs", "step", "flow-check", "loose"],
      "writes": [".planning/design/RULEBOOK.md", ".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "flow-check-gdd",
      "kind": "script",
      "needs": ["flow-check-rb"],
      "description": "The core loop, worked out from the Flow, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "flow-check", "worked out", "4"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "sections",
      "kind": "talk",
      "needs": ["flow-check-gdd"],
      "no": "3.2",
      "title": "The Rulebook",
      "description": "Then outward, one section at a time: winning, setup, the pieces, each action, edge cases, secrets, names",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.rulebook.win", "design.rulebook.setup", "design.rulebook.pieces", "design.rulebook.action", "design.rulebook.edge", "design.rulebook.secret", "design.rulebook.names", "design.rulebook.section", "design.rulebook.ok"],
      "must": ["design.rulebook.section", "design.rulebook.ok"],
      "craft": "craft/design-sections.md",
      "results": ["rulebook"]
    },
    {
      "id": "sections-rb",
      "kind": "script",
      "needs": ["sections"],
      "description": "The rulebook's first pass written, worked out in the GDD",
      "run": ["node", "{plugin}/scripts/rulebook.mjs", "step", "sections", "worked out"],
      "writes": [".planning/design/RULEBOOK.md", ".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "rules-done",
      "kind": "script",
      "needs": ["sections-rb"],
      "no": "3.2",
      "title": "The Rulebook",
      "description": "First pass done: what's still TBD, and the first Development Log entry",
      "run": ["node", "{plugin}/scripts/rulebook.mjs", "done-show"],
      "writes": [".planning/research/design-rulebook-done.md"],
      "show": ".planning/research/design-rulebook-done.md",
      "done": { "type": "file-contains", "path": ".planning/research/design-rulebook-done.md", "text": "First pass done." }
    },
    {
      "id": "content",
      "kind": "talk",
      "needs": ["rules-done"],
      "no": "3.3",
      "title": "Content & Balance",
      "description": "Every kind of thing in the game, one table each",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.content", "design.content.kinds", "design.content.columns"],
      "must": ["design.content.kinds", "design.content.columns"],
      "opening": ["design.content"],
      "craft": "craft/design-content.md",
      "results": ["tables"]
    },
    {
      "id": "content-fill",
      "kind": "script",
      "needs": ["content"],
      "description": "The tables, into content/data/ (the files the game reads) and onto your project page",
      "run": ["node", "{plugin}/scripts/tables.mjs", "step", "content", "worked out"],
      "writes": ["content/data/*.json", ".planning/design/tables.json", ".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "balance",
      "kind": "talk",
      "needs": ["content-fill"],
      "no": "3.3",
      "title": "Content & Balance",
      "description": "The balance values: what stands out, and fixes if you want them",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.content.balance", "design.content.playtest"],
      "must": ["design.content.playtest"],
      "opening": ["design.content.balance"],
      "craft": "craft/design-balance.md",
      "results": ["tables"]
    },
    {
      "id": "balance-fill",
      "kind": "script",
      "needs": ["balance"],
      "description": "Any fixes, into the tables (your own edits kept)",
      "run": ["node", "{plugin}/scripts/tables.mjs", "step", "balance", "worked out"],
      "writes": ["content/data/*.json", ".planning/design/tables.json", ".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "time",
      "kind": "talk",
      "needs": ["balance-fill"],
      "no": "3.4",
      "title": "Change Over Time",
      "description": "What changes during a game and between games; the common traps",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.time", "design.time.trap", "design.time.notrap"],
      "opening": ["design.time"],
      "craft": "craft/design-time.md",
      "results": ["chapters"]
    },
    {
      "id": "time-gdd",
      "kind": "script",
      "needs": ["time"],
      "description": "Change Over Time, worked out, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "time", "worked out", "10"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "scope2",
      "kind": "talk",
      "needs": ["time-gdd"],
      "no": "3.5",
      "title": "Scope & Risks, Second Pass",
      "description": "What the rulebook added, each sized: Must / Should / Could / Won't",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.scope2", "design.scope2.added", "define.scope.idea"],
      "must": ["design.scope2.added"],
      "opening": ["design.scope2"],
      "craft": "craft/design-scope2.md",
      "results": ["chapters", "added"]
    },
    {
      "id": "scope2-gdd",
      "kind": "script",
      "needs": ["scope2"],
      "description": "The scope and the effort vs impact chart, redrawn in the GDD and on your project page",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "scope2", "worked out"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "scope2-report",
      "kind": "talk",
      "needs": ["scope2-gdd"],
      "no": "3.5",
      "title": "Scope & Risks, Second Pass",
      "description": "What moved, the slice now, new risks and sketches; does the pitch still say it right?",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.scope2.report", "design.scope2.pitch", "define.pitch.take", "define.pitch.write", "define.pitch.mine", "define.pitch.how", "define.pitch.breath"],
      "opening": ["design.scope2.report"],
      "craft": "craft/design-scope2-report.md",
      "results": ["chapters", "pitch"]
    },
    {
      "id": "scope2-report-gdd",
      "kind": "script",
      "needs": ["scope2-report"],
      "description": "The slice, the risks, the pitch and the round 2 sketches, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "scope2-report", "worked out"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "players-read",
      "kind": "talk",
      "needs": ["scope2-report-gdd"],
      "no": "3.6",
      "title": "Players & Opponents",
      "description": "How similar games handle opponents, online play and saving (read first)",
      "tools": ["ToolSearch", "WebSearch", "WebFetch", "Read", "Glob", "Grep"],
      "lines": ["design.players"],
      "opening": ["design.players"],
      "craft": "craft/design-players-read.md",
      "results": ["found", "chapters"]
    },
    {
      "id": "players-read-gdd",
      "kind": "script",
      "needs": ["players-read"],
      "description": "What I read, with its sources, into the GDD (on your project page)",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "players-read", "loose"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "players",
      "kind": "talk",
      "needs": ["players-read-gdd"],
      "no": "3.6",
      "title": "Players & Opponents",
      "description": "The computer opponent, online people, a game's length and saving, accounts",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.players.read", "design.players.ai", "design.players.online", "design.players.length", "design.players.needs"],
      "must": ["design.players.length", "design.players.needs"],
      "opening": ["design.players.read"],
      "craft": "craft/design-players.md",
      "results": ["chapters", "needs"],
      "recap": ["found"]
    },
    {
      "id": "players-gdd",
      "kind": "script",
      "needs": ["players"],
      "description": "Players & Opponents and Platform & Play, worked out, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "players", "worked out"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "tdd-start",
      "kind": "script",
      "needs": ["players-gdd"],
      "description": "The technical plan, the TDD, started",
      "run": ["node", "{plugin}/scripts/design.mjs", "tdd-start"],
      "writes": [".planning/TDD.md", ".planning/project-page.html"]
    },
    {
      "id": "look",
      "kind": "talk",
      "needs": ["tdd-start"],
      "no": "3.7",
      "title": "Look & Sound",
      "description": "Pictures and games whose look you love; three looks to sketch",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.look", "design.look.refs"],
      "opening": ["design.look", "design.look.refs"],
      "craft": "craft/design-look.md",
      "results": ["looks", "refs"]
    },
    {
      "id": "look-build",
      "kind": "flow",
      "needs": ["look"],
      "no": "3.7",
      "title": "Look & Sound",
      "description": "The look sketches, side by side at real phone size",
      "workflow": "bmuz:sketch-flow",
      "args": { "mode": "look", "looks": "{looks}", "refs": "{refs}", "out": ".planning/research/sketches/look-sketches.html" },
      "agentTools": ["Read", "Write", "Edit", "Glob", "StructuredOutput"],
      "writes": [".planning/research/sketches/look-sketches.html"],
      "timeoutMs": 1200000,
      "done": { "type": "file-contains", "path": ".planning/research/sketches/look-sketches.html", "text": "data-look" }
    },
    {
      "id": "look-pick",
      "kind": "talk",
      "needs": ["look-build"],
      "no": "3.7",
      "title": "Look & Sound",
      "description": "Which look is closest; how the pieces move; how it sounds",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.look.sketches", "design.look.pick", "design.look.motion", "design.look.sound"],
      "must": ["design.look.motion", "design.look.sound"],
      "opening": ["design.look.sketches"],
      "craft": "craft/design-look-pick.md",
      "results": ["chapters"],
      "recap": ["looks"]
    },
    {
      "id": "look-gdd",
      "kind": "script",
      "needs": ["look-pick"],
      "description": "Look & Sound, worked out, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "look-pick", "worked out", "12"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "screens",
      "kind": "talk",
      "needs": ["look-gdd"],
      "no": "3.8",
      "title": "Screens & Menus",
      "description": "Every screen and what's on it; the UI style; what a new player must learn",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["design.screens", "design.screens.map", "design.screens.eyes", "design.screens.choose", "design.screens.end", "design.screens.style", "design.screens.teach"],
      "must": ["design.screens.eyes", "design.screens.choose", "design.screens.end", "design.screens.style", "design.screens.teach"],
      "opening": ["design.screens", "design.screens.map"],
      "craft": "craft/design-screens.md",
      "results": ["chapters", "style"]
    },
    {
      "id": "screens-gdd",
      "kind": "script",
      "needs": ["screens"],
      "description": "Screens & Menus worked out, Teaching's first notes, into the GDD",
      "run": ["node", "{plugin}/scripts/design.mjs", "gdd", "screens", "worked out", "14=loose"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "plan",
      "kind": "talk",
      "needs": ["screens-gdd"],
      "no": "3.9",
      "title": "The Build Plan",
      "description": "How it gets built, and in what order (my technical choices, told in plain words)",
      "tools": ["ToolSearch", "WebSearch", "WebFetch", "Read", "Glob", "Grep"],
      "lines": ["design.plan"],
      "opening": ["design.plan"],
      "craft": "craft/design-plan.md",
      "results": ["how", "tdd", "roadmap"]
    },
    {
      "id": "plan-write",
      "kind": "script",
      "needs": ["plan"],
      "no": "3.9",
      "title": "The Build Plan",
      "description": "The TDD and the roadmap, written and on your project page",
      "run": ["node", "{plugin}/scripts/design.mjs", "plan-write"],
      "writes": [".planning/TDD.md", ".planning/ROADMAP.md", ".planning/research/design-plan.md", ".planning/project-page.html"],
      "show": ".planning/research/design-plan.md",
      "done": { "type": "file-contains", "path": ".planning/research/design-plan.md", "text": "Here's how it'll be built:" }
    },
    {
      "id": "change",
      "kind": "talk",
      "needs": ["plan-write"],
      "onBack": true,
      "no": "3.10",
      "title": "Blueprint Review",
      "description": "What you want changed before building (only when you said \"Not yet\")",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["any.keep"],
      "craft": "craft/design-change.md",
      "results": ["chapters"]
    },
    {
      "id": "change-gdd",
      "kind": "script",
      "needs": ["change"],
      "description": "Your changes, into the GDD",
      "run": ["node", "{plugin}/scripts/gdd.mjs", "step", "change", "chosen"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "change-rb",
      "kind": "script",
      "needs": ["change-gdd"],
      "description": "Your rulebook changes, into the rulebook",
      "run": ["node", "{plugin}/scripts/rulebook.mjs", "step", "change", "loose"],
      "writes": [".planning/design/RULEBOOK.md", ".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "review-show",
      "kind": "script",
      "needs": ["change-rb"],
      "no": "3.10",
      "title": "Blueprint Review",
      "description": "One full read-through, everything on your project page",
      "run": ["node", "{plugin}/scripts/design.mjs", "review-show"],
      "writes": [".planning/research/design-review.md", ".planning/project-page.html"],
      "show": ".planning/research/design-review.md",
      "done": { "type": "file-contains", "path": ".planning/research/design-review.md", "text": "**Blueprint Review**" }
    },
    {
      "id": "review",
      "kind": "gate",
      "needs": ["review-show"],
      "no": "3.10",
      "title": "Blueprint Review",
      "description": "Ready to build?",
      "line": "design.review.box",
      "approve": "Approve: start building",
      "backTo": "change"
    },
    {
      "id": "approved",
      "kind": "script",
      "needs": ["review"],
      "retries": 0,
      "description": "The blueprint approved: logged in the GDD's Decisions and Changes",
      "run": ["node", "{plugin}/scripts/design.mjs", "approved"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    }
  ]
}
