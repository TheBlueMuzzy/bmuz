{
  "id": "ideate",
  "version": 1,
  "description": "Ideate: The Game So Far (F232, the approved script's Stage 1, framework .planning/research/bmuz-vision/bmuz-design-doc.html): 1.0 Welcome to BMUZ · 1.1 Your Idea · 1.2 Your Material · 1.3 The Game So Far (gate) · 1.4 Feelings & Hopes · 1.5 Open Ideas · 1.6 Sketch List · 1.7 Your Project Page (gate). Gathers everything about the idea, loose and unchosen, into the GDD (version 1: every chapter loose or plainly open), makes the sketch list, and opens the project page. The start is folded in: where the game stands is worked out, never asked. Every fixed line comes from plugin/script.md, word for word.",
  "watchdogMs": 1200000,
  "next": { "pipeline": "{onward}", "ask": false },
  "steps": [
    {
      "id": "idea",
      "kind": "talk",
      "needs": [],
      "no": "1.1",
      "title": "Your Idea",
      "description": "Welcome to BMUZ, then your idea in your own words",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.welcome", "ideate.idea", "ideate.spark"],
      "opening": ["ideate.welcome", "ideate.idea"],
      "craft": "craft/ideate-idea.md",
      "results": ["idea", "unsure"]
    },
    {
      "id": "material",
      "kind": "talk",
      "needs": ["idea"],
      "no": "1.2",
      "title": "Your Material",
      "description": "Your links, files and folders (Drive, GitHub, your computer)",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.material", "ideate.reading"],
      "opening": ["ideate.material"],
      "craft": "craft/ideate-material.md",
      "results": ["links", "files", "pasted"]
    },
    {
      "id": "fetch",
      "kind": "script",
      "needs": ["material"],
      "description": "Reading it all: the text of everything shared (files, folders, Drive, GitHub), and what the rest appears to be",
      "run": ["node", "{plugin}/scripts/ideate-fetch.mjs"],
      "timeoutMs": 480000,
      "writes": [".planning/research/shared.md", ".planning/research/shared.json"],
      "done": { "type": "file-contains", "path": ".planning/research/shared.md", "text": "## The text" }
    },
    {
      "id": "read",
      "kind": "talk",
      "needs": ["fetch"],
      "no": "1.3",
      "title": "The Game So Far",
      "description": "Sorting it into the GDD's chapters: what's already clear, your ideas, what's still open (nothing asked)",
      "tools": ["Read", "Glob", "Grep"],
      "craft": "craft/ideate-read.md",
      "results": ["sofar", "stands"]
    },
    {
      "id": "so-far",
      "kind": "script",
      "needs": ["read"],
      "description": "The game so far: the GDD, version 1 (your quotes checked against your words), shown to you; a finished game's rules go in as fixed, and it takes the conversion path (convert: yes)",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "so-far"],
      "results": ["convert", "fresh", "rulesask"],
      "writes": [".planning/GDD.md", ".planning/project-page.html", ".planning/research/ideate-so-far.md", ".planning/research/ideate-so-far.json", ".planning/research/fields.json"],
      "show": ".planning/research/ideate-so-far.md",
      "done": { "type": "file-contains", "path": ".planning/research/ideate-so-far.md", "text": "**The Game So Far**" }
    },
    {
      "id": "rules-ask",
      "kind": "talk",
      "needs": ["so-far"],
      "when": "{rulesask}",
      "no": "1.3",
      "title": "The Game So Far",
      "description": "A finished, played game whose rules weren't in what you shared (F234, from F233 task 11): asked once for them, a link or a file",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.rules.link"],
      "opening": ["ideate.rules.link"],
      "craft": "craft/ideate-rules-ask.md",
      "results": ["links", "files", "more"]
    },
    {
      "id": "rules-fetch",
      "kind": "script",
      "needs": ["rules-ask"],
      "when": "{more}",
      "description": "Reading the rules you pointed to, added to what you shared",
      "run": ["node", "{plugin}/scripts/ideate-fetch.mjs", "more", "rules-ask"],
      "writes": [".planning/research/shared.md", ".planning/research/shared.json"],
      "done": { "type": "file-contains", "path": ".planning/research/shared.md", "text": "## The text" }
    },
    {
      "id": "rules-read",
      "kind": "talk",
      "needs": ["rules-fetch"],
      "when": "{more}",
      "no": "1.3",
      "title": "The Game So Far",
      "description": "Sorting it all again, the rules with it (nothing asked)",
      "tools": ["Read", "Glob", "Grep"],
      "craft": "craft/ideate-read.md",
      "results": ["sofar", "stands"]
    },
    {
      "id": "rules-so-far",
      "kind": "script",
      "needs": ["rules-read"],
      "when": "{more}",
      "description": "The game so far again, with your rules: a finished game's rules go in as fixed, and it takes the conversion path",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "so-far", "rules-read"],
      "results": ["convert", "fresh", "rulesask"],
      "writes": [".planning/GDD.md", ".planning/project-page.html", ".planning/research/ideate-so-far.md", ".planning/research/ideate-so-far.json", ".planning/research/fields.json"],
      "show": ".planning/research/ideate-so-far.md",
      "done": { "type": "file-contains", "path": ".planning/research/ideate-so-far.md", "text": "**The Game So Far**" }
    },
    {
      "id": "next",
      "kind": "talk",
      "needs": ["rules-so-far"],
      "when": "{fresh}",
      "no": "1.3",
      "title": "The Game So Far",
      "description": "What next: carry on, jump to Define (when your notes cover it), or correct something",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.next", "ideate.correct"],
      "opening": ["ideate.next"],
      "craft": "craft/ideate-next.md",
      "results": ["choice"],
      "wrapTo": "page"
    },
    {
      "id": "next-gdd",
      "kind": "script",
      "needs": ["next"],
      "when": "{fresh}",
      "description": "Your corrections, into the GDD",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "add", "next"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "feelings",
      "kind": "talk",
      "needs": ["next-gdd"],
      "when": "{fresh}",
      "no": "1.4",
      "title": "Feelings & Hopes",
      "description": "How playing it should feel: a moment, what a player would tell a friend, your hopes and fears",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.feelings"],
      "opening": ["ideate.feelings"],
      "craft": "craft/ideate-feelings.md",
      "results": ["chapters", "moments"],
      "collects": [
        { "field": "feel.moment", "what": "A moment you'd love a player to have", "chapter": 1, "line": "ideate.feelings", "neededBy": [] },
        { "field": "feel.tell", "what": "What a player would tell a friend", "chapter": 1, "line": "ideate.feelings", "neededBy": [] },
        { "field": "feel.hopes", "what": "Your hopes and fears for it", "chapter": 7, "line": "ideate.feelings", "neededBy": [] }
      ]
    },
    {
      "id": "feelings-gdd",
      "kind": "script",
      "needs": ["feelings"],
      "when": "{fresh}",
      "description": "Your feelings, hopes and fears, into the GDD",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "add", "feelings"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "open-ideas",
      "kind": "talk",
      "needs": ["feelings-gdd"],
      "when": "{fresh}",
      "no": "1.5",
      "title": "Open Ideas",
      "description": "A few questions about the half-formed parts, hardest to change first (1–3 rounds)",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.open", "ideate.open.ask", "ideate.pool.mentioned", "ideate.pool.remember", "ideate.pool.end", "ideate.pool.skill", "ideate.pool.first", "ideate.added", "ideate.round"],
      "opening": ["ideate.open", "ideate.open.ask"],
      "must": ["ideate.added", "ideate.round"],
      "craft": "craft/ideate-open.md",
      "results": ["chapters", "rounds"],
      "recap": ["sofar"]
    },
    {
      "id": "open-gdd",
      "kind": "script",
      "needs": ["open-ideas"],
      "when": "{fresh}",
      "description": "Your answers, into the GDD",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "add", "open-ideas"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "rules-open",
      "kind": "talk",
      "needs": ["open-gdd"],
      "when": "{convert}",
      "no": "1.4",
      "title": "What Your Rules Leave Open",
      "description": "A finished game (F233): only what its rules leave open, and what the computer now does; in place of Feelings & Hopes and Open Ideas (F235: where it's played and who plays are asked once, in Define's Platform & Play)",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.rules", "ideate.open.ask", "ideate.rules.gap", "ideate.digital.computer", "ideate.added"],
      "opening": ["ideate.rules", "ideate.open.ask"],
      "must": ["ideate.added"],
      "craft": "craft/ideate-rules.md",
      "results": ["chapters"],
      "recap": ["sofar"],
      "collects": [
        { "field": "rules.gaps", "what": "What your rules leave open", "chapter": 8, "line": "ideate.rules.gap", "neededBy": [] },
        { "field": "computer.does", "what": "What the computer does for the players", "chapter": 14, "line": "ideate.digital.computer", "neededBy": [] }
      ]
    },
    {
      "id": "rules-gdd",
      "kind": "script",
      "needs": ["rules-open"],
      "when": "{convert}",
      "description": "Your answers, into the GDD",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "add", "rules-open"],
      "writes": [".planning/GDD.md", ".planning/project-page.html", ".planning/research/fields.json"]
    },
    {
      "id": "sketches",
      "kind": "talk",
      "needs": ["rules-gdd"],
      "no": "1.6",
      "title": "Sketch List",
      "description": "What to sketch: small throwaway pages that settle one question each (only the list today)",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.sketch", "ideate.sketch.pick", "ideate.sketch.more", "ideate.sketch.added"],
      "opening": ["ideate.sketch"],
      "must": ["ideate.sketch.more", "ideate.sketch.added"],
      "craft": "craft/ideate-sketches.md",
      "results": ["sketches"]
    },
    {
      "id": "sketch-gdd",
      "kind": "script",
      "needs": ["sketches"],
      "description": "The sketch list, into the GDD (S01, S02…)",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "add", "sketches"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    },
    {
      "id": "page",
      "kind": "script",
      "needs": ["sketch-gdd"],
      "always": true,
      "no": "1.7",
      "title": "Your Project Page",
      "description": "Your project page, opened in your browser, and what Ideate gathered",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "page"],
      "writes": [".planning/project-page.html", ".planning/research/ideate-page.md"],
      "show": ".planning/research/ideate-page.md",
      "stageEnd": true,
      "done": { "type": "file-contains", "path": ".planning/research/ideate-page.md", "text": "**Your Project Page**" }
    },
    {
      "id": "ready",
      "kind": "talk",
      "needs": ["page"],
      "always": true,
      "no": "1.7",
      "title": "Your Project Page",
      "description": "Ready for Define?",
      "tools": ["AskUserQuestion", "ToolSearch", "Read", "Glob", "Grep"],
      "lines": ["ideate.ready"],
      "opening": ["ideate.ready"],
      "craft": "craft/ideate-ready.md",
      "results": ["onward"]
    },
    {
      "id": "ready-gdd",
      "kind": "script",
      "needs": ["ready"],
      "always": true,
      "description": "Anything you added at the end, into the GDD",
      "run": ["node", "{plugin}/scripts/ideate.mjs", "add", "ready"],
      "writes": [".planning/GDD.md", ".planning/project-page.html"]
    }
  ]
}
